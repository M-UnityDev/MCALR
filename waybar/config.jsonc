{
    "position": "top",
    "modules-left": ["clock","cpu","memory","disk","hyprland/language"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": ["bluetooth","network","tray","battery","wireplumber","custom/power","temperature"],
    "hyprland/language": {
    "format-en": " EN",
    "format-ru": " RU"
    },
    "cpu": {
        "interval": 30,
        "format": " {usage}%",
        "on-click": "kitty --start-as=fullscreen btop -p 0"
    },
    "disk": {
        "interval": 30,
        "format": " {percentage_used}%",
        "tooltip-format": "{used} used out of {total} ({percentage_used}%)",
        "on-click": "kitty --start-as=fullscreen btop -p 0"
    },
    "memory": {
        "interval": 30,
        "format": " {}%",
        "tooltip-format": "Memory - {used:0.1f}GB used",
        "on-click": "kitty --start-as=fullscreen btop -p 0"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "spacing": 0,
        "on-click-middle" : "close",
        "tooltip-format": "{title}",
        "on-click": "activate"
    },
    "tray": {
        "icon-size": 16
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click-right": "kitty --hold --title calendar cal -y"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "",
        "format-disconnected": "󰅛",
		"format-disabled": "󰅛",
        "tooltip-format": "{essid}",
		"tooltip-format-ethernet": "{ifname}",
        "on-click": "kitty nmtui",
        "format-icons": ["󰤯","󰤟","󰤢","󰤢","󰤨"]
    },
    "bluetooth": {
        "format": "",
        "tooltip-format": "{status}",
        "on-click": "kitty bluetui",
    },
    "temperature": {
	"thermal-zone": 0,
	"hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 50,
        "format": "{temperatureC}°C",
        "tooltip": false
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
	"custom/power": {
		"format": "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
	},
    "wireplumber": {
		"format": " {volume}%",
        "on-click": "kitty --hold --title wpctl wpctl status"
    }

}
